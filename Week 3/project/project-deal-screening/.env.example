# Copy this file to .env and fill in your own key. Never commit .env to git.
# Get a key at: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=your-key-here

# Optional: override the default model per agent if you want to experiment
# (defaults are set in app/config.py)
EXTRACTION_MODEL=claude-sonnet-4-5
DILIGENCE_MODEL=claude-sonnet-4-5
SYNTHESIS_MODEL=claude-sonnet-4-5
