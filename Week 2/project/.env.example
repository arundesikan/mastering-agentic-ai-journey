# Copy this file to .env and fill in your real key.
# Works with either OpenAI directly, or Nebius AI Studio (OpenAI-compatible).
OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# If using Nebius instead, uncomment and set:
# OPENAI_BASE_URL=https://api.studio.nebius.ai/v1
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
